#!/usr/bin/env bash
# Run on a build worker. Provider workflows and developers use the same checks.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

case "${1:-native}" in
  -h|--help)
    printf '%s\n' 'Usage: ci/check [native|eval|list|all-systems|CHECK ...]' \
      'native builds all checks for this worker architecture (the default).' \
      'eval evaluates every declared architecture; it does not test foreign binaries.' \
      'all-systems requires builders for every declared architecture.' \
      'CHECK names select only affected native checks for a diagnosed rerun.'
    exit 0
    ;;
esac

ci_jobs=${NIX_BUILD_JOBS:-1}
ci_cores=${NIX_BUILD_CORES:-1}
for ci_limit in "$ci_jobs" "$ci_cores"; do
  [[ "$ci_limit" =~ ^[1-9][0-9]*$ ]] || { echo 'Nix build limits must be positive integers.' >&2; exit 2; }
done
nix_ci=(nix --option max-jobs "$ci_jobs" --option cores "$ci_cores" --option eval-cores 1)
ci_system=$("${nix_ci[@]}" eval --impure --raw --expr builtins.currentSystem)
ci_inventory=$("${nix_ci[@]}" eval --no-update-lock-file --raw \
  ".#checks.${ci_system}" --apply 'checks: builtins.concatStringsSep "\n" (builtins.attrNames checks)')
[[ -n "$ci_inventory" ]] || { echo "No checks declared for $ci_system; refusing empty success." >&2; exit 1; }
printf 'Worker: %s\nDeclared native checks:\n%s\n' "$ci_system" "$ci_inventory"

# This framework must never report success after silently losing a check.
ci_expected=$(printf '%s\n' clients-eval cluster-eval cluster-render)
if [[ "$ci_inventory" != "$ci_expected" ]]; then
  printf '%s\n' 'Check inventory differs from clients-eval, cluster-eval, cluster-render.' >&2
  exit 1
fi

case "${1:-native}" in
  list)
    [[ $# -eq 1 ]] || exit 2
    ;;
  native)
    [[ $# -le 1 ]] || exit 2
    printf '%s\n' "Coverage: native $ci_system execution only; foreign systems are not certified."
    "${nix_ci[@]}" flake check --no-update-lock-file --keep-going --print-build-logs
    ;;
  eval)
    [[ $# -eq 1 ]] || exit 2
    printf '%s\n' 'Coverage: all-system evaluation only; no foreign runtime execution.'
    "${nix_ci[@]}" flake check --no-update-lock-file --all-systems --no-build --keep-going --print-build-logs
    ;;
  all-systems)
    [[ $# -eq 1 ]] || exit 2
    "${nix_ci[@]}" flake check --no-update-lock-file --all-systems --keep-going --print-build-logs
    ;;
  *)
    ci_targets=()
    for ci_check in "$@"; do
      [[ "$ci_check" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "Invalid check name: $ci_check" >&2; exit 2; }
      ci_found=false
      while IFS= read -r ci_declared; do
        [[ "$ci_declared" != "$ci_check" ]] || ci_found=true
      done <<< "$ci_inventory"
      "$ci_found" || { echo "Undeclared native check: $ci_check" >&2; exit 2; }
      ci_targets+=(".#checks.${ci_system}.${ci_check}")
    done
    printf 'Coverage: selected native checks: %s\n' "$*"
    "${nix_ci[@]}" build --no-update-lock-file --no-link --keep-going --print-build-logs "${ci_targets[@]}"
    ;;
esac
